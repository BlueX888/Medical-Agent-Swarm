# OpenAI-compatible LLM
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=8192
LLM_STREAMING=true

# Short-term memory (Redis required)
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MEMORY_TTL=86400
SHORT_TERM_MEMORY_MAX_MESSAGES=40

# Workflow checkpoints (sqlite for local development; postgres for production)
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=.data/checkpoints.sqlite3
CHECKPOINT_POSTGRES_DSN=
# Production override: exactly 16, 24, or 32 UTF-8 bytes.
# When SQLite is selected and this is empty, a random local key is created here:
CHECKPOINT_AES_KEY=
CHECKPOINT_AES_KEY_FILE=.data/checkpoint.key
# Local development only; never enable for real medical data
CHECKPOINT_ALLOW_PLAINTEXT=false
# Required to inspect/replay checkpoints through the debug API
CHECKPOINT_ADMIN_TOKEN=replace-with-a-long-random-token

# Agent observability (external tracing is opt-in)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent-swarm
LANGSMITH_REDACT_MEDICAL_TEXT=true
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_ENTRYPOINT=api
OBSERVABILITY_HASH_KEY=
APP_VERSION=unknown

# Local RAG knowledge base (disabled by default for backward compatibility)
RAG_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
RAG_COLLECTION_ALIAS=medical_knowledge_current
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_ADMIN_TOKEN=replace-with-a-long-random-token
RAG_CANDIDATE_COUNT=12
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.55
RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_CHUNK_TOKENS=420
RAG_CHUNK_OVERLAP=60
RAG_MAX_FILE_BYTES=26214400
RAG_CATALOG_PATH=.data/knowledge/catalog.sqlite3
RAG_DOCUMENTS_PATH=.data/knowledge/documents
MEDQUAD_SOURCE_PATH=.data/sources/medquad
MEDQUAD_REVISION=577bd37b96c02d1833b2c9eed2de9f96964e96cb
MEDQUAD_BATCH_SIZE=128
