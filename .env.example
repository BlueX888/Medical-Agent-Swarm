# OpenAI-compatible LLM
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=8192
LLM_STREAMING=true

# Short-term memory (Redis required)
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MEMORY_TTL=86400
SHORT_TERM_MEMORY_MAX_MESSAGES=40

# Agent observability (external tracing is opt-in)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent-swarm
LANGSMITH_REDACT_MEDICAL_TEXT=true
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_ENTRYPOINT=api
OBSERVABILITY_HASH_KEY=
APP_VERSION=unknown
