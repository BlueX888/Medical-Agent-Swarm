# LLM API fallback config (OpenAI-compatible endpoint).
# Prefer configuring OPENAI_* variables in .env; environment variables override
# these values at runtime. Keep this file only for backward compatibility.
LLM_CONFIG = {
    "api_key": "your-api-key",
    "model_name": "your-model",
    "base_url": "https://api.openai.com/v1",
    "temperature": 0.7,
    "max_tokens": 8192,
}

# Mem0 API config (Long-term memory, optional, https://app.mem0.ai)
MEM0_CONFIG = {
    "api_key": "m0-your-mem0-key",
}

# Short-term memory is configured with environment variables:
#   REDIS_URL=redis://localhost:6379/0
#   SHORT_TERM_MEMORY_TTL=86400
#   Hard-capped at 20 messages (10 complete turns)
#   SHORT_TERM_MEMORY_MAX_MESSAGES=20

# LangSmith observability is configured with environment variables:
#   LANGSMITH_TRACING=true
#   LANGSMITH_API_KEY=lsv2_...
#   LANGSMITH_PROJECT=medical-agent-swarm
# Medical text is redacted by default before being sent to LangSmith.
# Set LANGSMITH_REDACT_MEDICAL_TEXT=false only in safe, non-PHI test data.
